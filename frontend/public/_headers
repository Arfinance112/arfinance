# Encabezados de seguridad de Netlify (Vite copia este archivo a dist/).
# connect-src: la API en Fly.io y Supabase (login). Si cambiás el nombre de la app en Fly, actualizalo acá.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://*.fly.dev https://pznuwkdoognzequxjnez.supabase.co wss://pznuwkdoognzequxjnez.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'
